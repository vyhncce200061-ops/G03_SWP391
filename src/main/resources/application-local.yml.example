# Copy thanh application-local.yml va dien thong tin tren may ban.
# Khong dua application-local.yml chua mat khau len Git.
spring:
  datasource:
    # Mat khau SQL Server tren may ban; khac voi mat khau tai khoan Admin tren web.
    username: sa
    password: ""
  mail:
    host: smtp.gmail.com
    port: 587
    username: ""
    password: ""
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true
      mail.smtp.starttls.required: true

petshop:
  mail-from: ${spring.mail.username}
  public-base-url: http://localhost:8081

# Khoa Base64 tu 32 byte ngau nhien; khong dua khoa that len Git.
# De trong: tao khoa tam, link dang ky khong con dung duoc sau khi restart.
app:
  jwt:
    registration-encryption-key: ${REGISTRATION_ENCRYPTION_KEY:}

# Bat rieng cho demo Sandbox localhost de xac nhan ket qua Return da ky.
vnpay:
  sandbox-return-confirmation-enabled: ${VNPAY_SANDBOX_RETURN_CONFIRMATION_ENABLED:false}
